{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/**/*.{mjs,cjs,js,ts}",
    "desktop/**/*.{cjs,mjs,js}",
    "tests/**/*.ts",
    "e2e/**/*.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{mjs,cjs,js,ts}",
    "desktop/**/*.{cjs,mjs,js}",
    "tests/**/*.ts",
    "e2e/**/*.ts"
  ],
  "ignoreDependencies": [
    "tailwindcss",
    "tw-animate-css",
    "shadcn",
    "electron-builder",
    "@electron/rebuild",
    "sharp",
    "puppeteer"
  ],
  "ignoreFiles": [
    "src/components/dashboard/hero-card.tsx",
    "src/components/help/what-is.tsx",
    "src/components/home/more-section.tsx",
    "src/components/layout/simple-top-bar.tsx"
  ],
  "ignoreIssues": {
    "src/components/ui/**": ["exports", "types"],
    "src/server/sync/orchestrator.ts": ["exports", "types"],
    "src/server/sync/otp-bridge.ts": ["exports"]
  },
  "tags": ["-unfinished"]
}
